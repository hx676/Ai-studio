{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncanvas.local/schemas/node-extension.schema.json",
  "title": "SynCanvas Node Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "nodes"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "name_zh": {"type": "string", "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 1000},
    "description_zh": {"type": "string", "maxLength": 1000},
    "app_version": {"type": "string", "maxLength": 80},
    "enabled_by_default": {"type": "boolean"},
    "web_directory": {"type": "string"},
    "requirements": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "types"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "name": {"type": "string"},
        "name_zh": {"type": "string", "maxLength": 120},
        "types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required": {"type": "boolean"},
        "multiple": {"type": "boolean"}
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 180, "maximum": 1600},
        "height": {"type": "integer", "minimum": 100, "maximum": 2000}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "display_name_zh": {"type": "string", "maxLength": 120},
        "description": {"type": "string", "maxLength": 500},
        "description_zh": {"type": "string", "maxLength": 500},
        "category": {"type": "string"},
        "icon": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "surfaces": {"type": "array", "items": {"enum": ["classic", "smart"]}, "uniqueItems": true},
        "legacy_types": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "defaults": {"type": "object"},
        "size": {
          "type": "object",
          "properties": {"classic": {"$ref": "#/$defs/size"}, "smart": {"$ref": "#/$defs/size"}},
          "additionalProperties": false
        },
        "execution": {"enum": ["python", "frontend", "host"]},
        "backend_class": {"type": "string"},
        "frontend_key": {"type": "string"}
      }
    }
  }
}
