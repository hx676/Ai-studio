#!/bin/bash
set -u

CONTENTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CORE_SOURCE="$CONTENTS_DIR/Resources/core"
VERSION="$(tr -d '\r\n' < "$CORE_SOURCE/VERSION")"
SUPPORT_ROOT="$HOME/Library/Application Support/SynCanvas"
RUNTIME_ROOT="$SUPPORT_ROOT/runtime/$VERSION"
SHARED_ROOT="$SUPPORT_ROOT/shared"
VENV_ROOT="$SUPPORT_ROOT/venv"
LOG_ROOT="$SUPPORT_ROOT/logs"
LOG_FILE="$LOG_ROOT/launcher.log"
SERVICE_LOG="$LOG_ROOT/service.log"
PID_FILE="$SUPPORT_ROOT/service.pid"
APP_URL="http://127.0.0.1:3000/"

mkdir -p "$SUPPORT_ROOT/runtime" "$SHARED_ROOT" "$LOG_ROOT"
touch "$LOG_FILE"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

notify() {
    /usr/bin/osascript - "$1" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
    display notification (item 1 of argv) with title "SynCanvas"
end run
APPLESCRIPT
}

show_error() {
    log "ERROR: $1"
    /usr/bin/osascript - "$1" "$LOG_FILE" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
    set choice to button returned of (display dialog (item 1 of argv) with title "SynCanvas 启动失败" buttons {"退出", "查看日志"} default button "查看日志")
    if choice is "查看日志" then
        do shell script "open -R " & quoted form of (item 2 of argv)
    end if
end run
APPLESCRIPT
    exit 1
}

safe_remove_runtime_path() {
    case "$1" in
        "$SUPPORT_ROOT"/runtime/*) rm -rf "$1" ;;
        *) show_error "拒绝清理不安全的运行目录：$1" ;;
    esac
}

prepare_runtime() {
    if [ -f "$RUNTIME_ROOT/.syncanvas-runtime-ready" ]; then
        return
    fi
    local staging="$SUPPORT_ROOT/runtime/.${VERSION}.staging"
    safe_remove_runtime_path "$staging"
    mkdir -p "$staging"
    log "Copying application runtime to $RUNTIME_ROOT"
    /usr/bin/ditto "$CORE_SOURCE" "$staging" || show_error "复制 SynCanvas 核心文件失败。"
    safe_remove_runtime_path "$RUNTIME_ROOT"
    /bin/mv "$staging" "$RUNTIME_ROOT" || show_error "启用 SynCanvas 核心目录失败。"
    touch "$RUNTIME_ROOT/.syncanvas-runtime-ready"
}

link_shared_dir() {
    local relative="$1"
    local shared="$SHARED_ROOT/$relative"
    local target="$RUNTIME_ROOT/$relative"
    mkdir -p "$shared" "$(dirname "$target")"
    if [ -L "$target" ]; then
        return
    fi
    if [ -e "$target" ]; then
        rm -rf "$target"
    fi
    ln -s "$shared" "$target" || show_error "创建共享数据目录失败：$relative"
}

find_python() {
    export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
    local candidate
    for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3 "$(command -v python3 2>/dev/null || true)"; do
        [ -n "$candidate" ] || continue
        [ -x "$candidate" ] || continue
        if "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

ensure_venv() {
    local bootstrap_python="$1"
    local requirements_hash
    requirements_hash="$(/usr/bin/shasum -a 256 "$RUNTIME_ROOT/requirements.lock" | /usr/bin/awk '{print $1}')"
    local marker="$VENV_ROOT/.syncanvas-requirements-$requirements_hash"
    if [ -x "$VENV_ROOT/bin/python" ] && [ -f "$marker" ]; then
        return
    fi
    notify "首次启动正在安装 Python 依赖，请稍候。"
    log "Preparing Python environment with $bootstrap_python"
    if [ ! -x "$VENV_ROOT/bin/python" ]; then
        rm -rf "$VENV_ROOT"
        "$bootstrap_python" -m venv "$VENV_ROOT" >> "$LOG_FILE" 2>&1 || show_error "创建 Python 隔离环境失败，请安装 Python 3.10 或更高版本。"
    fi
    "$VENV_ROOT/bin/python" -m pip install --upgrade pip setuptools wheel >> "$LOG_FILE" 2>&1 || show_error "更新 Python 安装工具失败，请检查网络后重试。"
    "$VENV_ROOT/bin/python" -m pip install -r "$RUNTIME_ROOT/requirements.lock" >> "$LOG_FILE" 2>&1 || show_error "安装 SynCanvas Python 依赖失败，请检查网络并查看日志。"
    rm -f "$VENV_ROOT"/.syncanvas-requirements-*
    touch "$marker"
}

service_ready() {
    /usr/bin/curl --silent --fail --max-time 2 "http://127.0.0.1:3000/api/app-info" 2>/dev/null | /usr/bin/grep -q '"version"'
}

start_service() {
    if service_ready; then
        /usr/bin/open "$APP_URL"
        exit 0
    fi
    if [ -f "$PID_FILE" ]; then
        local old_pid
        old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
        if [ -n "$old_pid" ] && /bin/kill -0 "$old_pid" 2>/dev/null; then
            log "Waiting for existing service process $old_pid"
        else
            rm -f "$PID_FILE"
        fi
    fi
    if [ ! -f "$PID_FILE" ]; then
        log "Starting SynCanvas $VERSION"
        cd "$RUNTIME_ROOT" || show_error "无法进入 SynCanvas 运行目录。"
        nohup /usr/bin/env \
            SYNCANVAS_MAIN_HOST=127.0.0.1 \
            SYNCANVAS_MAIN_PORT=3000 \
            SYNCANVAS_MACOS_APP=1 \
            PYTHONUTF8=1 \
            PYTHONIOENCODING=utf-8 \
            PYTHONDONTWRITEBYTECODE=1 \
            "$VENV_ROOT/bin/python" "$RUNTIME_ROOT/main.py" >> "$SERVICE_LOG" 2>&1 < /dev/null &
        echo $! > "$PID_FILE"
    fi
    local attempt=0
    while [ "$attempt" -lt 120 ]; do
        if service_ready; then
            notify "SynCanvas 已启动。"
            /usr/bin/open "$APP_URL"
            exit 0
        fi
        attempt=$((attempt + 1))
        sleep 0.5
    done
    rm -f "$PID_FILE"
    show_error "SynCanvas 服务未能在 60 秒内启动，请查看日志。"
}

prepare_runtime
for relative in API data components output packages/components workflows assets/input assets/output; do
    link_shared_dir "$relative"
done

PYTHON_BIN="$(find_python || true)"
if [ -z "$PYTHON_BIN" ]; then
    /usr/bin/osascript <<'APPLESCRIPT' >/dev/null 2>&1 || true
set choice to button returned of (display dialog "SynCanvas 需要 Python 3.10 或更高版本。请先安装 Python，然后重新打开 SynCanvas。" with title "需要安装 Python" buttons {"退出", "打开下载页面"} default button "打开下载页面")
if choice is "打开下载页面" then open location "https://www.python.org/downloads/macos/"
APPLESCRIPT
    exit 1
fi

ensure_venv "$PYTHON_BIN"
start_service
